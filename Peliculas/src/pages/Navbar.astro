---
import Navbar from '../components/Navbar.vue';
import Layout from '../layouts/Layout.astro';
---

<Layout title="MovieRadar | Navegación">
	<Navbar client:load />
	<main class="nav-page">
		<a href="/">Ir al catálogo</a>
	</main>
</Layout>

<style>
	.nav-page {
		width: min(1180px, calc(100% - 40px));
		margin: 48px auto;
	}

	.nav-page a {
		color: #166534;
		font-weight: 700;
	}
</style>
