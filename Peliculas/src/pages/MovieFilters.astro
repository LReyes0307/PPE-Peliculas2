---
export const prerender = false;
// Ruta SSR de búsqueda que comparte la consulta pública del catálogo.

import MovieCatalog from '../components/MovieCatalog.vue';
import Layout from '../layouts/Layout.astro';
import { getPublicMoviePage } from '../lib/public-movies';

const moviePage = await getPublicMoviePage(
	Astro.locals.supabase,
	Astro.url.searchParams,
);
---

<Layout title="MovieRadar | Filtros">
  <MovieCatalog client:load {...moviePage} eyebrow="BIBLIOTECA" heading="Buscar películas" />
</Layout>
