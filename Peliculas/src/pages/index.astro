---
import MovieCatalog from '../components/MovieCatalog.vue';
import Navbar from '../components/Navbar.vue';
import Layout from '../layouts/Layout.astro';
---

<Layout title="MovieRadar | Catálogo">
	<Navbar client:load />
	<main class="page-content">
		<header class="page-heading">
			<div>
				<p class="eyebrow">BIBLIOTECA</p>
				<h1>Películas</h1>
			</div>
		</header>

		<MovieCatalog client:load />
	</main>
</Layout>

<style>
	.page-content {
		width: min(1180px, calc(100% - 40px));
		margin: 0 auto;
		padding: 48px 0 72px;
	}

	.page-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 30px;
	}

	.eyebrow {
		margin: 0 0 8px;
		color: #c2410c;
		font-size: 12px;
		font-weight: 800;
	}

	h1 {
		margin: 0;
		font-size: 34px;
	}

	@media (max-width: 560px) {
		.page-content {
			width: min(100% - 28px, 1180px);
			padding-top: 32px;
		}

		.page-heading {
			align-items: start;
			flex-direction: column;
		}
	}
</style>