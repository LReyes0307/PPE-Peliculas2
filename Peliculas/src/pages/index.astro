---
export const prerender = false;
// Ruta SSR pública: consulta y pagina el catálogo en cada solicitud.

import MovieCatalog from '../components/MovieCatalog.vue';
import Layout from '../layouts/Layout.astro';
import { getPublicMoviePage } from '../lib/public-movies';

const moviePage = await getPublicMoviePage(
	Astro.locals.supabase,
	Astro.url.searchParams,
);
---

<Layout title="MovieRadar | Catálogo">
  <MovieCatalog client:load {...moviePage} />
</Layout>
